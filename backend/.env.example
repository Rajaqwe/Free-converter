# Server Port (assigned dynamically by Render, Cloud Run, etc.)
PORT=10000

# Server Host bind address
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated or * for public access)
ALLOWED_ORIGINS=https://rajaqwe.github.io

# Maximum upload file size in megabytes
MAX_FILE_SIZE_MB=50

# Maximum distinct source outline colours mapped to HPGL pen numbers (2-256)
HPGL_MAX_PEN_COLORS=16

# Temporary working directory (optional; defaults to system temp or runtime/ inside app)
# TEMP_DIR=/tmp
